# ==============================================================================
# AutoCommit Agent Environment Configuration
# Copy this file to .env locally or set these variables in your Render Dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NVIDIA Nemotron-3 Ultra Configuration
# ------------------------------------------------------------------------------
# Get your NVIDIA Nemotron API Key from: https://build.nvidia.com
# Starts with "nvapi-..."
NEMOTRON_API_KEY=nvapi-your-nemotron3-ultra-api-key-here
# (AI_API_KEY also supported as an alias)
AI_API_KEY=nvapi-your-nemotron3-ultra-api-key-here

# NVIDIA NIM OpenAI-compatible API base URL (default: https://integrate.api.nvidia.com/v1)
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# Target Nemotron Model (Nemotron 3 Ultra 550b-a55b)
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ------------------------------------------------------------------------------
# 2. GitHub Push Target Configuration
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT). Generate at: https://github.com/settings/tokens
# Requirements:
# - Classic Token: check 'repo' scope
# - Fine-Grained Token: Repository access -> Select your repo -> Permissions -> Contents: Read and write
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Target repository in format "owner/repo" (e.g. adityasharma/my-daily-notes)
GITHUB_REPO=your-github-username/your-repo-name

# Target branch to commit to (default: main)
GITHUB_BRANCH=main

# File to append the 5 lines into (default: daily-log.md)
TARGET_FILE_PATH=daily-log.md

# ------------------------------------------------------------------------------
# 3. Git Author & Committer Attribution (Required for GitHub Contribution Graph)
# ------------------------------------------------------------------------------
# Set GIT_AUTHOR_NAME to your GitHub username (e.g. ADITYASHARMAjac)
GIT_AUTHOR_NAME=ADITYASHARMAjac

# Set GIT_AUTHOR_EMAIL to your verified GitHub email address (e.g. your-email@example.com)
# NOTE: GitHub's contribution graph ONLY credits commits whose author email matches a verified email on your account!
GIT_AUTHOR_EMAIL=your-github-verified-email@example.com

# ------------------------------------------------------------------------------
# 4. Schedule Configuration (3 Times Daily)
# ------------------------------------------------------------------------------
# Standard Cron Expression for 3x daily (09:00, 14:00, 20:00 UTC)
# Format: minute hour day-of-month month day-of-week
CRON_SCHEDULE=0 9,14,20 * * *

# Timezone (e.g. UTC, Asia/Kolkata, America/New_York)
CRON_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 5. Server Port
# ------------------------------------------------------------------------------
# Render automatically sets PORT. For local development, defaults to 3000
PORT=3000
